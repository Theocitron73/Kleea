{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Lancer Projet Complet",
            "dependsOn": [
                "run-backend",
                "run-frontend"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "run-backend",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "windows": {
                "command": ".\\venv\\Scripts\\activate; uvicorn main:app --reload"
            },
            "osx": {
                "command": "source ${workspaceFolder}/venv/bin/activate && uvicorn main:app --reload"
            },
            "linux": {
                "command": "source ${workspaceFolder}/venv/bin/activate && uvicorn main:app --reload"
            },
            "isBackground": true,
            "presentation": {
                "group": "server-group",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "run-frontend",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "command": "npm run dev",
            "isBackground": true,
            "presentation": {
                "group": "server-group",
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ]
}